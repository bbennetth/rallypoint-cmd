[Unit]
Description=Rallypoint cmd game-server panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rallypoint-cmd
EnvironmentFile=/etc/rallypoint-cmd/panel.env
ExecStart=/usr/bin/node /opt/rallypoint-cmd/apps/server/dist/server.js
Restart=always
RestartSec=3
# Steady-state the panel sits well under 512M, but self-update runs
# `npm ci` as a child in this cgroup — cap it where that fits.
MemoryMax=1536M
SyslogIdentifier=rallypoint-cmd

[Install]
WantedBy=multi-user.target

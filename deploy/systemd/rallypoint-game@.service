[Unit]
Description=Rallypoint game server (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Per-game specifics (WorkingDirectory, stop signal, memory limits, and
# the ReadWritePaths entry for the install dir) live in the drop-in the
# panel writes at
# /etc/systemd/system/rallypoint-game@<slug>.service.d/instance.conf,
# and the start command in /etc/rallypoint-cmd/games/<slug>/start.sh —
# both generated from the game registry (packages/shared/src/games.ts).
ExecStart=/etc/rallypoint-cmd/games/%i/start.sh
Restart=on-failure
RestartSec=10
OOMPolicy=stop
# Esync-capable Wine builds allocate one eventfd per Windows sync object,
# so a Wine game can hold hundreds of thousands of fds; running out mid-
# session kills the server. Native games are unaffected by the headroom.
LimitNOFILE=1048576
# Game ticks should win CPU over the panel/steamcmd during installs, updates and backups (default weight 100).
CPUWeight=200
SyslogIdentifier=rallypoint-game-%i

# Game servers execute third-party binaries and load user-supplied mods,
# so they run sandboxed: read-only filesystem except the paths below,
# no access to /root or /home, a private /tmp, and no way to gain
# privileges. The per-game drop-in adds that game's install dir to
# ReadWritePaths.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/games

[Install]
WantedBy=multi-user.target

[Unit]
Description=Rallypoint game server (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=palworld
Group=palworld
# Per-game specifics (WorkingDirectory, memory limits, stop signal) live
# in the drop-in written by `rallypoint-cmd-game add <slug>` at
# /etc/systemd/system/rallypoint-game@<slug>.service.d/instance.conf,
# and the start command in /etc/rallypoint-cmd/games/<slug>/start.sh —
# both generated from the game registry, root-owned, never panel-written.
ExecStart=/etc/rallypoint-cmd/games/%i/start.sh
Restart=on-failure
RestartSec=10
OOMPolicy=stop
LimitNOFILE=100000
SyslogIdentifier=rallypoint-game-%i

[Install]
WantedBy=multi-user.target

[Unit]
Description=Rallypoint game server (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Per-game specifics (WorkingDirectory, stop signal, memory limits, and
# the ReadWritePaths entry for the install dir) live in the drop-in the
# panel writes at
# /etc/systemd/system/rallypoint-game@<slug>.service.d/instance.conf,
# and the start command in /etc/rallypoint-cmd/games/<slug>/start.sh —
# both generated from the game registry (packages/shared/src/games.ts).
ExecStart=/etc/rallypoint-cmd/games/%i/start.sh
Restart=on-failure
RestartSec=10
OOMPolicy=stop
# Esync-capable Wine builds allocate one eventfd per Windows sync object,
# so a Wine game can hold hundreds of thousands of fds; running out mid-
# session kills the server. Native games are unaffected by the headroom.
LimitNOFILE=1048576
# Game ticks should win CPU over the panel/steamcmd during installs, updates and backups (default weight 100).
CPUWeight=200
SyslogIdentifier=rallypoint-game-%i

# Game servers execute third-party binaries and load user-supplied mods,
# so they run sandboxed: read-only filesystem except that game's own
# install dir (granted by the per-instance drop-in's ReadWritePaths, so
# one game cannot write into another's), no access to /root or /home, a
# private /tmp, and no way to gain privileges.
#
# The unit runs as root inside the unprivileged container, and the mount
# namespace protections below can be undone by a root process that still
# holds CAP_SYS_ADMIN. So the capability set is emptied and the mount /
# module / namespace syscalls are filtered, which is what makes
# ProtectSystem= and friends binding rather than advisory. Game ports are
# all above 1024, and Wine, Mono/Unity JIT and 32-bit Steam bits work
# without capabilities; MemoryDenyWriteExecute and
# SystemCallArchitectures=native are deliberately absent because they do
# not.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=~@mount @module @reboot @swap @clock @cpu-emulation @obsolete @raw-io
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

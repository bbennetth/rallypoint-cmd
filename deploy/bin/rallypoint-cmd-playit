#!/usr/bin/env bash
# rallypoint-cmd-playit — pinned root helper for the playit.gg agent.
#
# Installed at /usr/local/bin/rallypoint-cmd-playit (root:root 0755) and
# whitelisted in /etc/sudoers.d/rallypoint-cmd. The panel (unprivileged
# `rallypoint` user) drives the playit.gg agent exclusively through these
# fixed verbs — it never touches playit config or apt itself.
#
# Verbs:
#   install        add the playit apt repo + install the package (idempotent)
#   claim <code>   exchange a claim code for the agent secret, enable + start
#   start | stop   control the playit service
#   secret         print the agent secret to stdout (panel uses it for api.playit.gg)
#   reset          stop the service and remove the secret (un-claim)
#   status         print "installed=<0|1> claimed=<0|1> active=<state>"
#   logs           print the last 200 lines of the agent's journal

set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

VERB="${1:-}"

# The apt package ships a service; the exact unit name is detected because
# packaging has varied (playit.service vs playitd.service).
unit_name() {
  for u in playit playitd; do
    if systemctl list-unit-files "${u}.service" --no-legend 2>/dev/null | grep -q .; then
      echo "${u}.service"
      return
    fi
  done
  echo "playit.service"
}

# The packaged systemd unit runs playitd with a fixed secret path
# (`ExecStart=... --secret-path /etc/playit/playit.toml`). `playit
# secret-path` can't be used to discover it: since the daemon split it
# answers over the playitd socket, which requires the service to already
# be running.
SECRET_FILE=/etc/playit/playit.toml

is_installed() { command -v playit >/dev/null 2>&1; }

is_claimed() {
  [[ -f "$SECRET_FILE" ]] && grep -q 'secret_key' "$SECRET_FILE" 2>/dev/null
}

case "$VERB" in
  install)
    if is_installed; then echo "playit already installed"; exit 0; fi
    curl -fsSL https://playit-cloud.github.io/ppa/key.gpg | gpg --dearmor -o /etc/apt/trusted.gpg.d/playit.gpg
    echo "deb [signed-by=/etc/apt/trusted.gpg.d/playit.gpg] https://playit-cloud.github.io/ppa/data ./" \
      > /etc/apt/sources.list.d/playit-cloud.list
    apt-get -qq update
    apt-get -qq -y install playit
    systemctl disable --now "$(unit_name)" >/dev/null 2>&1 || true
    echo "playit installed"
    ;;

  claim)
    CODE="${2:-}"
    [[ "$CODE" =~ ^[a-z0-9]{4,64}$ ]] || { echo "invalid claim code" >&2; exit 1; }
    is_installed || { echo "playit is not installed" >&2; exit 1; }
    # Blocks until the user approves the claim in their browser (or times
    # out). `claim exchange` only PRINTS the secret (progress lines first,
    # secret on the last line) — persisting it where playitd reads it is
    # on us; only the interactive `playit setup` flow does it itself.
    OUT="$(playit claim exchange "$CODE" --wait 300)"
    SECRET="$(tail -n1 <<<"$OUT" | tr -d '[:space:]')"
    [[ "$SECRET" =~ ^[A-Za-z0-9]{32,128}$ ]] \
      || { echo "claim exchange did not return a secret" >&2; exit 1; }
    install -d -m 0750 -o playit -g playit "$(dirname "$SECRET_FILE")"
    (umask 077; printf 'secret_key = "%s"\n' "$SECRET" > "$SECRET_FILE")
    chown playit:playit "$SECRET_FILE"
    chmod 0600 "$SECRET_FILE"
    systemctl enable "$(unit_name)" >/dev/null 2>&1
    # restart, not `enable --now`: a daemon left running without a secret
    # (WaitingForSecret) won't re-read the file on its own.
    systemctl restart "$(unit_name)"
    echo "claimed and started"
    ;;

  start)
    systemctl enable --now "$(unit_name)"
    ;;

  stop)
    systemctl disable --now "$(unit_name)"
    ;;

  secret)
    is_claimed || { echo "not claimed" >&2; exit 1; }
    # Print ONLY the secret value (strip toml key syntax + quotes).
    grep 'secret_key' "$SECRET_FILE" | head -n1 | sed -E 's/.*=\s*"?([A-Za-z0-9]+)"?\s*$/\1/'
    ;;

  reset)
    # `playit reset` needs the daemon socket, which we're about to stop —
    # removing the secret file directly is equivalent for the packaged unit.
    systemctl disable --now "$(unit_name)" >/dev/null 2>&1 || true
    rm -f "$SECRET_FILE"
    echo "reset"
    ;;

  status)
    inst=0; claimed=0; active=inactive
    is_installed && inst=1
    is_claimed && claimed=1
    active="$(systemctl is-active "$(unit_name)" 2>/dev/null || echo inactive)"
    echo "installed=$inst claimed=$claimed active=$active"
    ;;

  logs)
    journalctl -u "$(unit_name)" -n 200 --no-pager -o short-iso 2>/dev/null || echo "(no agent journal)"
    ;;

  *)
    echo "usage: rallypoint-cmd-playit {install|claim <code>|start|stop|secret|reset|status}" >&2
    exit 1
    ;;
esac

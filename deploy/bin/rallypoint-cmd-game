#!/usr/bin/env bash
# rallypoint-cmd-game — pinned root helper that provisions the systemd
# side of a game-server instance (template unit drop-in + start script).
#
# Installed at /usr/local/bin/rallypoint-cmd-game (root:root 0755).
# Whitelisted in sudoers per fixed `<verb> <slug>` argv line (no
# wildcards) so the panel can provision/deprovision units on server
# create/delete; the slug is re-validated below against the baked-in
# game table, preserving the wildcard-free sudoers model. Operators can
# also run it directly.
#
# Usage: rallypoint-cmd-game add <slug>
#        rallypoint-cmd-game remove <slug>
#
# Game parameters (start command, stop signal, memory limits, install
# dir) are baked in below, generated from packages/shared/src/games.ts.
# Keep in lockstep with the registry.

set -euo pipefail

VERB="${1:?usage: rallypoint-cmd-game add|remove <slug>}"
SLUG="${2:?usage: rallypoint-cmd-game add|remove <slug>}"

[[ "$SLUG" =~ ^[a-z0-9-]{1,32}$ ]] || { echo "refusing: bad slug" >&2; exit 1; }

GAMES_ROOT=/opt/games
CONF_ROOT=/etc/rallypoint-cmd/games
DROPIN_DIR="/etc/systemd/system/rallypoint-game@${SLUG}.service.d"

# slug|start command (relative to install dir)|stop signal|timeout|memhigh|memmax|platform
# platform: empty = native Linux; "windows" = run under Wine.
game_row() {
  case "$1" in
    palworld)            echo "./PalServer.sh -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS|SIGINT|90|22G|24G|" ;;
    valheim)             echo "./valheim_server.x86_64 -nographics -batchmode -name Rallypoint -port 2456 -world Dedicated -public 0|SIGINT|60|4G|6G|" ;;
    rust)                echo "./RustDedicated -batchmode +server.port 28015 +server.identity rallypoint +server.maxplayers 50|SIGINT|120|||" ;;
    ark-survival-evolved) echo "./ShooterGame/Binaries/Linux/ShooterGameServer TheIsland?listen?SessionName=Rallypoint -server -log|SIGINT|120|||" ;;
    7-days-to-die)       echo "./7DaysToDieServer.x86_64 -configfile=serverconfig.xml -logfile /dev/stdout -quit -batchmode -nographics -dedicated|SIGINT|120|||" ;;
    project-zomboid)     echo "./start-server.sh -servername rallypoint|SIGTERM|120|||" ;;
    satisfactory)        echo "./FactoryServer.sh|SIGINT|90|||" ;;
    team-fortress-2)     echo "./srcds_run -game tf +map cp_dustbowl +maxplayers 24|SIGTERM|30|||" ;;
    counter-strike-2)    echo "./game/bin/linuxsteamrt64/cs2 -dedicated +map de_dust2|SIGTERM|30|||" ;;
    unturned)            echo "./ServerHelper.sh +InternetServer/rallypoint|SIGINT|60|||" ;;
    enshrouded)          echo "./enshrouded_server.exe|SIGINT|120|12G|16G|windows" ;;
    *) echo "refusing: unknown game slug $1" >&2; exit 1 ;;
  esac
}

case "$VERB" in
  add)
    ROW="$(game_row "$SLUG")"
    START_CMD="${ROW%%|*}"; REST="${ROW#*|}"
    STOP_SIGNAL="${REST%%|*}"; REST="${REST#*|}"
    TIMEOUT="${REST%%|*}"; REST="${REST#*|}"
    MEM_HIGH="${REST%%|*}"; REST="${REST#*|}"
    MEM_MAX="${REST%%|*}"; PLATFORM="${REST#*|}"
    INSTALL_DIR="$GAMES_ROOT/$SLUG"

    install -d -o rallypoint -g rallypoint "$INSTALL_DIR"
    install -d -o root -g root "$CONF_ROOT/$SLUG" "$DROPIN_DIR"

    if [[ "$PLATFORM" == "windows" ]]; then
      # Windows-only server: run under Wine. The prefix lives inside the
      # install dir so it travels with the game and is owned by rallypoint.
      cat > "$CONF_ROOT/$SLUG/start.sh" <<EOF
#!/bin/sh
# Generated by rallypoint-cmd-game — do not edit (regenerate instead).
cd "$INSTALL_DIR"
export HOME="$INSTALL_DIR"
export WINEPREFIX="$INSTALL_DIR/.wine"
export WINEDEBUG=-all
exec /usr/bin/wine64 $START_CMD
EOF
    else
      cat > "$CONF_ROOT/$SLUG/start.sh" <<EOF
#!/bin/sh
# Generated by rallypoint-cmd-game — do not edit (regenerate instead).
cd "$INSTALL_DIR"
export HOME="$INSTALL_DIR"
export LD_LIBRARY_PATH="$INSTALL_DIR:$INSTALL_DIR/linux64:\${LD_LIBRARY_PATH:-}"
exec $START_CMD
EOF
    fi
    chmod 0755 "$CONF_ROOT/$SLUG/start.sh"

    {
      echo "[Service]"
      echo "WorkingDirectory=$INSTALL_DIR"
      echo "KillSignal=$STOP_SIGNAL"
      echo "TimeoutStopSec=$TIMEOUT"
      [[ -n "$MEM_HIGH" ]] && echo "MemoryHigh=$MEM_HIGH"
      [[ -n "$MEM_MAX" ]] && echo "MemoryMax=$MEM_MAX"
    } > "$DROPIN_DIR/instance.conf"
    chmod 0644 "$DROPIN_DIR/instance.conf"

    systemctl daemon-reload
    systemctl enable -q "rallypoint-game@${SLUG}.service"
    echo "provisioned rallypoint-game@${SLUG}.service ($INSTALL_DIR)"
    ;;
  remove)
    systemctl disable -q --now "rallypoint-game@${SLUG}.service" 2>/dev/null || true
    rm -rf "$DROPIN_DIR" "$CONF_ROOT/$SLUG"
    systemctl daemon-reload
    echo "removed rallypoint-game@${SLUG}.service (game files in $GAMES_ROOT/$SLUG untouched)"
    ;;
  *)
    echo "usage: rallypoint-cmd-game add|remove <slug>" >&2
    exit 1
    ;;
esac

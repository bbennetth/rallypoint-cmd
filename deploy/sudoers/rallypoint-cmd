# /etc/sudoers.d/rallypoint-cmd   (install root:root 0440; verify: visudo -cf <file>)
#
# The panel runs as the `palworld` user and needs exactly two privileged
# capabilities per game unit: bounce it, and tail its journal. Everything
# else (files, saves, config, steamcmd, backups) it owns directly.
#
# Wildcard-free on purpose — a `systemctl *` sudoers wildcard is a classic
# privilege-escalation footgun. These argv strings must match the frozen
# constants in apps/server/src/services/constants.ts EXACTLY: the legacy
# palworld.service plus one rallypoint-game@<slug>.service line per game
# registry slug (packages/shared/src/games.ts). Drift-tested by
# apps/server/src/services/real-hardening.test.ts.

palworld ALL=(root) NOPASSWD: /usr/bin/systemctl start palworld.service
palworld ALL=(root) NOPASSWD: /usr/bin/systemctl stop palworld.service
palworld ALL=(root) NOPASSWD: /usr/bin/systemctl restart palworld.service
palworld ALL=(root) NOPASSWD: /usr/bin/journalctl -u palworld.service -n 500 -o cat -f
palworld ALL=(root) NOPASSWD: /usr/bin/systemctl start rallypoint-game@palworld.service
palworld ALL=(root) NOPASSWD: /usr/bin/systemctl stop rallypoint-game@palworld.service
palworld ALL=(root) NOPASSWD: /usr/bin/systemctl restart rallypoint-game@palworld.service
palworld ALL=(root) NOPASSWD: /usr/bin/journalctl -u rallypoint-game@palworld.service -n 500 -o cat -f

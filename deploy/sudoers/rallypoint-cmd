# /etc/sudoers.d/rallypoint-cmd   (install root:root 0440; verify: visudo -cf <file>)
#
# The panel runs as the `rallypoint` user and needs exactly three privileged
# capabilities per game unit: bounce it, tail its journal, and provision/
# deprovision its unit (start.sh + drop-in) via the pinned rallypoint-cmd-game
# helper. Everything else (files, saves, config, steamcmd, backups) it owns
# directly.
#
# Wildcard-free on purpose — a `systemctl *` sudoers wildcard is a classic
# privilege-escalation footgun. These argv strings must match the frozen
# constants in apps/server/src/services/constants.ts EXACTLY: one
# rallypoint-game@<slug>.service line per game registry slug
# (packages/shared/src/games.ts). Drift-tested by
# apps/server/src/services/real-hardening.test.ts.

rallypoint ALL=(root) NOPASSWD: /usr/bin/systemctl start rallypoint-game@palworld.service
rallypoint ALL=(root) NOPASSWD: /usr/bin/systemctl stop rallypoint-game@palworld.service
rallypoint ALL=(root) NOPASSWD: /usr/bin/systemctl restart rallypoint-game@palworld.service
rallypoint ALL=(root) NOPASSWD: /usr/bin/journalctl -u rallypoint-game@palworld.service -n 500 -o cat -f
rallypoint ALL=(root) NOPASSWD: /usr/bin/systemctl start rallypoint-game@valheim.service
rallypoint ALL=(root) NOPASSWD: /usr/bin/systemctl stop rallypoint-game@valheim.service
